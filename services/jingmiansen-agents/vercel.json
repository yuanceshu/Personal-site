{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,**/__pycache__/**,**/*.pyc,data/**}"
    }
  },
  "crons": [
    {
      "path": "/internal/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
