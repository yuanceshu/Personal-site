JINGMIANSEN_SITE_URL=http://localhost:3001

# AI Solution Lab: secrets stay on the server
EXPERIMENT_AGENT_URL=http://127.0.0.1:8002
EXPERIMENT_AGENT_TOKEN=

# Island Travel public AI: atomic shared rate counter; never client variables.
# Production/Preview refuse live calls if these are absent. Local dev is in-memory.
ISLAND_RATE_REDIS_URL=
ISLAND_RATE_REDIS_TOKEN=
ISLAND_RATE_SALT=

# Restaurant Agent public AI: independent rate counter; local development is in-memory.
RESTAURANT_RATE_REDIS_URL=
RESTAURANT_RATE_REDIS_TOKEN=
RESTAURANT_RATE_SALT=

# Linquan public AI: independent rate counter; local development is in-memory.
LINQUAN_RATE_REDIS_URL=
LINQUAN_RATE_REDIS_TOKEN=
LINQUAN_RATE_SALT=

# Finance Agent public rate limit; local development uses in-memory counters.
FINANCE_RATE_REDIS_URL=
FINANCE_RATE_REDIS_TOKEN=
FINANCE_RATE_SALT=

# Qintai Ticketing public AI (customer chat + merchant console): independent rate
# counter, one bucket per side; local development is in-memory.
QINTAI_RATE_REDIS_URL=
QINTAI_RATE_REDIS_TOKEN=
QINTAI_RATE_SALT=

# Medical AI public explanation: independent rate counter; local development is in-memory.
MEDICAL_RATE_REDIS_URL=
MEDICAL_RATE_REDIS_TOKEN=
MEDICAL_RATE_SALT=

# Heating Demo: page-only simulated state, no Redis/SQLite or file storage.
# Set to 0 to disable; when omitted the configured Agent can serve this Demo.
HEATING_DEMO_ENABLED=0
# Optional separate capsule encryption key. Otherwise reuses server-only EXPERIMENT_AGENT_TOKEN.
HEATING_SESSION_SECRET=
# Optional server-only reset permission; the H5 restart button never needs this token.
HEATING_DEVELOPER_TOKEN=
# Only for an existing Agent deployment with Vercel Deployment Protection.
HEATING_AGENT_PROTECTION_BYPASS=
# VERCEL_AUTOMATION_BYPASS_SECRET, when enabled on the main Vercel project,
# is used only for protected server-to-server callbacks; never sent to H5 or the model.
