{
  "name": "main",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:lab": "tsx --test tests/ai-solution-lab/*.test.ts",
    "test:lab:browser": "playwright test --config=tests/ai-solution-lab/playwright.config.ts",
    "test:travel": "tsx --test tests/island-travel/*.test.ts",
    "test:travel:browser": "playwright test --config=tests/island-travel/playwright.config.ts",
    "test:ui-lab": "tsx --test tests/ui-lab/*.test.ts",
    "test:ui-lab:browser": "playwright test --config=tests/ui-lab/playwright.config.ts"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
